{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "method-lock",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "specification_revision": {
      "const": "4"
    },
    "adopted_packages": {
      "type": "object",
      "properties": {
        "omnx-code": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "integrity_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "version",
            "integrity_digest",
            "source_revision"
          ],
          "additionalProperties": false
        },
        "security-auditor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "integrity_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "version",
                "integrity_digest",
                "source_revision"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "omnx-code",
        "security-auditor"
      ],
      "additionalProperties": false
    },
    "audit_contract_version": {
      "const": "2.0"
    },
    "control_registry_revision": {
      "type": "integer",
      "minimum": 1
    },
    "last_migration_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "specification_revision",
    "adopted_packages",
    "audit_contract_version",
    "control_registry_revision",
    "last_migration_id"
  ],
  "additionalProperties": false
}
