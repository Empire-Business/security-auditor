{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkpoint",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "worktree_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "git_worktree",
            "filesystem"
          ]
        },
        "base_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128
            }
          ]
        },
        "head_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128
            }
          ]
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                ]
              },
              "git_index_blob": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 128
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "git_index_blob"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment_observed": {
          "type": "boolean"
        },
        "environment_config_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "required": [
        "kind",
        "base_revision",
        "head_revision",
        "content_digest",
        "files",
        "environment",
        "environment_observed",
        "environment_config_digest"
      ],
      "additionalProperties": false
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "temporary_context": {
      "type": "string",
      "maxLength": 4000
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "worktree_id",
    "session_id",
    "task_id",
    "task_sha256",
    "snapshot",
    "next_action",
    "temporary_context",
    "created_at"
  ],
  "additionalProperties": false
}
