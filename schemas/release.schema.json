{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "deploying",
        "deployed",
        "healthy",
        "failed",
        "rolled_back"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "artifact_digest",
    "environment",
    "authorization_ref",
    "status",
    "observed_at",
    "evidence_refs",
    "limitations"
  ],
  "additionalProperties": false
}
