{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[A-Za-z0-9][A-Za-z0-9-]{1,90}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "blocked",
        "review",
        "done",
        "cancelled"
      ]
    },
    "authorization": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "authorized",
            "revoked"
          ]
        },
        "basis_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        }
      },
      "required": [
        "status",
        "basis_ref"
      ],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 100
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "updated_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "impact": {
      "type": "object",
      "properties": {
        "ux": {
          "type": "string",
          "enum": [
            "UX0",
            "UX1",
            "UX2",
            "UX3"
          ]
        },
        "security": {
          "type": "string",
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "ux",
        "security",
        "rationale"
      ],
      "additionalProperties": false
    },
    "owner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ]
    },
    "blocked_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ]
    },
    "closure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "scope_met": {
              "type": "boolean"
            },
            "diff_reviewed": {
              "type": "boolean"
            },
            "documentation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "known_regression": {
              "type": "boolean"
            },
            "delivery": {
              "type": "string",
              "enum": [
                "patch",
                "branch",
                "pull_request",
                "merged",
                "sandbox",
                "production",
                "investigation"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "result": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "not_run",
                      "unavailable",
                      "not_applicable"
                    ]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "ref",
                  "result",
                  "summary"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 100
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 50
            },
            "authority_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "scope_met",
            "diff_reviewed",
            "documentation",
            "known_regression",
            "delivery",
            "evidence",
            "limitations",
            "authority_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "cancel_reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "authorization",
    "acceptance",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
