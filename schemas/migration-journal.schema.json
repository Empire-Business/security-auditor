{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "migration-journal",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "migration_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "preparing",
        "snapshotted",
        "applying",
        "applied",
        "rolling_back",
        "rolled_back"
      ]
    },
    "snapshot_ready": {
      "type": "boolean"
    },
    "completed_ops": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
      },
      "uniqueItems": true
    },
    "rollback_ops": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "updated_at": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    }
  },
  "required": [
    "schema_version",
    "migration_id",
    "plan_digest",
    "phase",
    "snapshot_ready",
    "completed_ops",
    "rollback_ops",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
