{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit-request",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "2.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^ARQ-[A-Za-z0-9-]{3,90}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
        }
      ]
    },
    "orchestrator_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{2,100}$"
        }
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "design",
        "delta",
        "full"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "security_impact": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3"
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "git_worktree",
            "filesystem"
          ]
        },
        "base_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128
            }
          ]
        },
        "head_revision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 128
            }
          ]
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                ]
              },
              "git_index_blob": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 128
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256",
              "git_index_blob"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment_observed": {
          "type": "boolean"
        },
        "environment_config_digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      },
      "required": [
        "kind",
        "base_revision",
        "head_revision",
        "content_digest",
        "files",
        "environment",
        "environment_observed",
        "environment_config_digest"
      ],
      "additionalProperties": false
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "control_registry_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "requested_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SEC-[A-Z]+-[0-9]{2}$"
      },
      "maxItems": 200,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 100
    },
    "permissions": {
      "type": "object",
      "properties": {
        "application_writes": {
          "const": false
        },
        "network_access": {
          "type": "boolean"
        },
        "allowed_network_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 30
        },
        "sandbox_test_execution": {
          "type": "boolean"
        },
        "production_access": {
          "const": false
        }
      },
      "required": [
        "application_writes",
        "network_access",
        "allowed_network_targets",
        "sandbox_test_execution",
        "production_access"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_related_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 256,
          "maximum": 16000
        },
        "max_correction_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "max_related_files",
        "max_tool_calls",
        "max_output_tokens",
        "max_correction_cycles"
      ],
      "additionalProperties": false
    },
    "expansion_policy": {
      "const": "related_dependencies_with_reason"
    }
  },
  "required": [
    "contract_version",
    "request_id",
    "project_id",
    "task_id",
    "orchestrator_id",
    "mode",
    "objective",
    "security_impact",
    "snapshot",
    "policy_digest",
    "control_registry_digest",
    "changed_paths",
    "surfaces",
    "requested_controls",
    "evidence_refs",
    "permissions",
    "budget",
    "expansion_policy"
  ],
  "additionalProperties": false
}
